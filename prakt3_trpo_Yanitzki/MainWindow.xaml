<Window x:Class="prakt3_trpo_Yanitzki.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prakt3_trpo_Yanitzki"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <DockPanel Background="#DDDDDD">
        <TextBlock Text="Анкета кандидата" Background="CornflowerBlue" DockPanel.Dock="Top" Height="25" TextAlignment="Left" Padding="10, 3, 0, 0" FontSize="14" Foreground="White"/>
        <TextBlock Text="Анкета не отправлена" Background="#CCCCCC" DockPanel.Dock="Bottom" Height="20" TextAlignment="Left" Padding="10, 2, 0, 0" FontSize="10" Foreground="Gray"/>
        
        <Grid Margin="10" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Личные данные" Margin="10" Foreground="#424880" FontWeight="Bold"/>
            <Grid Margin="10, 25, 0, 0" Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Height="22" Width="250" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Height="22" Width="250" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Электронная почта" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Height="22" Width="250" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Город" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Height="22" Width="250" HorizontalAlignment="Left"/>
            </Grid>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Профессиональные сведения" Margin="10" Foreground="#424880" FontWeight="Bold"/>
            <Grid Margin="10, 25, 0, 0" Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Должность" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Height="22" SelectedIndex="0" Width="230" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Разработчик C#"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Опыт работы" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Height="22" SelectedIndex="0" Width="230" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Без опыта"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Образование" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Height="22" SelectedIndex="0" Width="230" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Среднее общее"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Желаемая зарплата" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Height="22" Width="230" HorizontalAlignment="Left"/>
            </Grid>

            <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" Margin="10, 0, 0, 5">
                <RadioButton Content="Полная занятость" IsChecked="True" Margin="0,2"/>
                <RadioButton Content="Частичная занятость" Margin="0,2"/>
                <RadioButton Content="Стажировка" Margin="0,2"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="О себе" Foreground="#424880" FontWeight="Bold" Margin="10, 0, 0, 5"/>
            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" AcceptsReturn="True" TextWrapping="Wrap" Height="70" HorizontalAlignment="Left"  Width="760" Margin="10, 0, 0, 0"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Навыки" Foreground="#424880" FontWeight="Bold" Margin="10, 0, 0, 0"/>
            <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10, 20, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                <CheckBox Content="C#" Margin="0, 0, 20, 8"/>
                <CheckBox Content="SQL" Margin="0, 0, 20, 8"/>
                <CheckBox Content="Git" Margin="0, 0, 20, 8"/>
                <CheckBox Content="WPF" Margin="0, 0, 20, 8"/>
                <CheckBox Content="HTML/CSS" Margin="0, 0, 20, 8"/>
                <CheckBox Content="Тестирование" Margin="0, 0, 20, 8"/>
                <CheckBox Content="Английский язык" Margin="0, 0, 20, 8"/>
            </WrapPanel>
 
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20, 0, 0, 10">
                <Button Content="Прикрепить резюме" Padding="5" Margin="0,0,10,0"/>
                <Button Content="Отправить" Padding="5" Margin="0,0,10,0" Width="90"/>
                <Button Content="Отмена" Padding="5" Width="90"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
